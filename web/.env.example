# ==============================================================================
# BoardBuddy — Environment Configuration & Credentials Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION (REQUIRED)
# Obtain from your Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"


# ------------------------------------------------------------------------------
# 2. GEMINI AI ENGINE (REQUIRED)
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
VITE_GEMINI_API_KEY="your-gemini-api-key-here"


# ------------------------------------------------------------------------------
# 3. XENDIT PAYMENT GATEWAY (REQUIRED FOR ONLINE PAYMENTS)
# Obtain from Xendit Dashboard > Developers > API Keys (https://dashboard.xendit.co/)
# ------------------------------------------------------------------------------
XENDIT_SECRET_KEY="your-xendit-secret-key-here"
XENDIT_WEBHOOK_TOKEN="your-xendit-webhook-token-here"
XENDIT_API_BASE_URL="https://api.xendit.co"


# ------------------------------------------------------------------------------
# 4. APP DEPLOYMENT URLS (REQUIRED FOR REDIRECTS & WEBHOOKS)
# ------------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMIN EMAIL
# ------------------------------------------------------------------------------
INITIAL_SUPERADMIN_EMAIL="boardbuddy.team@gmail.com"


# ------------------------------------------------------------------------------
# 6. ANDROID APK DOWNLOAD URL (OPTIONAL, DEFAULTS TO /boardbuddy.apk)
# ------------------------------------------------------------------------------
VITE_APK_DOWNLOAD_URL="/boardbuddy.apk"
